---
import "../styles/global.css"
import { apkUrl, releaseUrl, repository, version } from "../config/site"

interface Props {
  title?: string
  description?: string
}

const {
  title = "KubeDeck: Kubernetes, in your pocket",
  description = "KubeDeck is an open-source Android Kubernetes client for cluster resources, workloads, logs, exec, port forwarding, Helm, Flux, and Argo CD.",
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const pageUrl = new URL("/", Astro.site)
const ogImage = new URL("/og.png", Astro.site)
const ogImageAlt = "KubeDeck: Your cluster, where you are. Open-source Kubernetes client for Android."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b0a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={new URL("/favicon.svg", Astro.site)} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="KubeDeck" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ builtVersion: version, builtApkUrl: apkUrl, builtReleaseUrl: releaseUrl, repository }}>
      // The page is static, so a release published after the last deploy would leave every link on
      // the build-time version. Ask GitHub for the newest release in the browser and repoint them.
      fetch("https://api.github.com/repos/rinci-labs/kubedeck/releases/latest", {
        headers: { Accept: "application/vnd.github+json" },
      })
        .then((response) => (response.ok ? response.json() : null))
        .then((release) => {
          const tag = release && release.tag_name
          if (!tag || !/^v\d+\.\d+\.\d+$/.test(tag)) return
          const latest = tag.slice(1)
          if (latest === builtVersion) return
          const apk = (release.assets || []).find((asset) => asset.name.endsWith(".apk"))
          const apkUrl = apk ? apk.browser_download_url : `${repository}/releases/download/${tag}/KubeDeck-${tag}.apk`
          const releaseUrl = release.html_url || `${repository}/releases/tag/${tag}`
          document.querySelectorAll("a").forEach((link) => {
            if (link.href === builtApkUrl) link.href = apkUrl
            else if (link.href === builtReleaseUrl) link.href = releaseUrl
          })
          document.querySelectorAll("[data-release-version]").forEach((node) => (node.textContent = latest))
          document.querySelectorAll("[data-release-label]").forEach((node) => (node.textContent = "Latest release"))
        })
        .catch(() => {})
    </script>
  </body>
</html>
