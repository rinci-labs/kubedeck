---
import { Button } from "@almach/ui/button"
import { ArrowRight, ArrowUpRight, Download } from "lucide-react"
import { apkUrl, isFirstRelease, releaseUrl, repository, version } from "../config/site"
import ClusterPreview from "./ClusterPreview"
import Container from "./Container.astro"
import HexField from "./HexField.astro"
import LogStream from "./LogStream.astro"
import PortForwardChip from "./PortForwardChip.astro"
import SyncCard from "./SyncCard.astro"
---

<section id="top" aria-labelledby="hero-title" class="pt-14 pb-20 sm:pt-20 sm:pb-28">
  <Container>
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <a
        href={releaseUrl}
        target="_blank"
        rel="noreferrer"
        class="group inline-flex items-center gap-2 rounded-full border border-border bg-card py-1 pl-1 pr-3 text-xs text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground motion-safe:animate-rise"
      >
        <span class="rounded-full bg-success-soft px-2 py-0.5 font-medium text-primary">New</span>
        {isFirstRelease ? "First release" : "Latest release"}, v{version}
        <ArrowRight aria-hidden="true" className="size-3 transition-transform group-hover:translate-x-0.5" />
      </a>
      <h1 id="hero-title" class="mt-7 text-balance text-5xl font-semibold leading-[1.02] tracking-tighter motion-safe:animate-rise motion-safe:[animation-delay:80ms] sm:text-6xl lg:text-7xl">
        Your cluster, <span class="text-primary">where you are.</span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-pretty text-lg leading-relaxed text-muted-foreground motion-safe:animate-rise motion-safe:[animation-delay:160ms]">
        Inspect resources, follow workloads, and handle everyday Kubernetes operations from your phone.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3 motion-safe:animate-rise motion-safe:[animation-delay:240ms]">
        <Button href={apkUrl} size="lg"><Download aria-hidden="true" />Download APK</Button>
        <Button href={repository} variant="outline" size="lg" target="_blank" rel="noreferrer">View source<ArrowUpRight aria-hidden="true" /></Button>
      </div>
    </div>

    <figure class="mt-16 motion-safe:animate-rise motion-safe:[animation-delay:320ms] sm:mt-20">
      <div class="relative isolate grid items-center gap-10 overflow-hidden rounded-2xl border border-border bg-card px-4 py-10 sm:py-14 lg:grid-cols-[1fr_auto_1fr] lg:px-10">
        <HexField />
        <div class="hidden justify-end lg:flex">
          <div class="motion-safe:animate-float">
            <LogStream />
          </div>
        </div>
        <ClusterPreview client:visible />
        <div class="hidden flex-col items-start gap-5 lg:flex">
          <div class="motion-safe:animate-float motion-safe:[animation-delay:-2.5s]">
            <PortForwardChip />
          </div>
          <div class="ml-8 motion-safe:animate-float motion-safe:[animation-delay:-5s]">
            <SyncCard />
          </div>
        </div>
      </div>
      <figcaption class="mt-3 text-center text-xs text-muted-foreground">Illustrative layout with sample data. Tap the tabs to switch screens.</figcaption>
    </figure>
  </Container>
</section>
