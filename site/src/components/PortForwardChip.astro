---
import { Badge } from "@almach/ui/badge"
import { Card } from "@almach/ui/card"
import { ArrowRight, Cable } from "lucide-react"
---

<Card className="flex items-center gap-3 py-3 pl-3 pr-4 shadow-xl shadow-foreground/5">
  <span class="grid size-9 place-items-center rounded-sm bg-success-soft text-primary">
    <Cable aria-hidden="true" className="size-4" strokeWidth={1.75} />
  </span>
  <div class="space-y-0.5">
    <p class="flex items-center gap-1.5 font-mono text-[11px] font-medium">
      localhost:8080 <ArrowRight aria-hidden="true" className="size-3 text-muted-foreground" /> checkout:80
    </p>
    <p class="flex items-center gap-2 text-[10px] text-muted-foreground">
      Port-forward
      <Badge variant="success" size="sm">Active</Badge>
    </p>
  </div>
</Card>
