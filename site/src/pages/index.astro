---
import DownloadCta from "../components/DownloadCta.astro"
import FeatureGrid from "../components/FeatureGrid.astro"
import Hero from "../components/Hero.astro"
import Section from "../components/Section.astro"
import SecurityPanel from "../components/SecurityPanel.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import Base from "../layouts/Base.astro"
---

<Base>
  <a href="#main" class="fixed left-3 top-3 z-50 -translate-y-[200%] rounded-md bg-foreground px-4 py-3 text-sm text-background focus:translate-y-0">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <Hero />

    <Section
      id="features"
      title="The cluster, closer at hand."
      lead="Made for inspection and everyday operations on the move. KubeDeck talks to the Kubernetes API directly, with actions governed by your existing access."
    >
      <FeatureGrid />
    </Section>

    <Section
      id="security"
      tone="muted"
      title="Your credentials stay on your device."
      lead="An early release built to be reviewed. Read the source and your cluster access policies before connecting."
    >
      <SecurityPanel />
    </Section>

    <DownloadCta />
  </main>

  <SiteFooter />
</Base>
